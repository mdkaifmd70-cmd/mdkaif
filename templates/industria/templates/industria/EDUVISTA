<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<meta name="description"
content="Professional School, College and Educational Institute Website Template">

<meta name="theme-color" content="#1e3a8a">

<title>EDUVISTA | School & Institute</title>

<style>

/* =========================================================
   V7 — SCHOOL / COLLEGE / INSTITUTE TEMPLATE
   MD Kaif Web Platform
   ========================================================= */

:root{
    --primary:#1e3a8a;
    --primary-dark:#172554;
    --secondary:#f59e0b;
    --secondary-dark:#d97706;
    --accent:#2563eb;

    --dark:#0f172a;
    --text:#334155;
    --muted:#64748b;

    --white:#ffffff;
    --light:#f8fafc;
    --light-blue:#eff6ff;
    --light-yellow:#fffbeb;

    --border:#e2e8f0;

    --success:#16a34a;
    --danger:#dc2626;

    --radius:18px;

    --shadow:
        0 15px 45px rgba(15,23,42,.08);

    --shadow-lg:
        0 25px 70px rgba(15,23,42,.15);
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

html{
    scroll-behavior:smooth;
}

body{
    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    color:var(--text);
    background:#fff;
    line-height:1.6;
}

img{
    max-width:100%;
    display:block;
}

a{
    color:inherit;
    text-decoration:none;
}

button,
input,
textarea,
select{
    font:inherit;
}

.container{
    width:min(1180px,92%);
    margin:auto;
}

.section{
    padding:95px 0;
}

.section-sm{
    padding:65px 0;
}

.section-head{
    max-width:720px;
    margin:0 auto 52px;
    text-align:center;
}

.section-tag{
    display:inline-flex;
    align-items:center;
    gap:8px;

    color:var(--primary);

    font-size:12px;
    font-weight:900;

    text-transform:uppercase;
    letter-spacing:1.8px;

    margin-bottom:13px;
}

.section-tag::before{
    content:"";

    width:28px;
    height:2px;

    background:var(--secondary);
}

.section-title{
    color:var(--dark);

    font-size:
        clamp(31px,4vw,48px);

    line-height:1.12;

    letter-spacing:-1.5px;

    font-weight:850;

    margin-bottom:16px;
}

.section-description{
    color:var(--muted);
    font-size:15px;
}

.btn{
    min-height:48px;

    padding:0 21px;

    border-radius:10px;

    display:inline-flex;
    align-items:center;
    justify-content:center;

    gap:8px;

    border:1px solid transparent;

    cursor:pointer;

    transition:.25s ease;

    font-size:13px;
    font-weight:800;
}

.btn-primary{
    background:var(--primary);
    color:#fff;
}

.btn-primary:hover{
    background:var(--primary-dark);
    transform:translateY(-2px);
}

.btn-secondary{
    background:var(--secondary);
    color:#111827;
}

.btn-secondary:hover{
    background:var(--secondary-dark);
    transform:translateY(-2px);
}

.btn-light{
    background:#fff;
    color:var(--primary);
}

.btn-light:hover{
    transform:translateY(-2px);
}

.btn-outline{
    background:transparent;
    border-color:var(--primary);
    color:var(--primary);
}

.btn-outline:hover{
    background:var(--primary);
    color:#fff;
}


/* =========================================================
   TOP BAR
   ========================================================= */

.topbar{
    background:var(--primary-dark);
    color:#dbeafe;

    font-size:12px;

    padding:9px 0;
}

.topbar-inner{
    display:flex;

    justify-content:space-between;
    align-items:center;

    gap:20px;
}

.topbar-left,
.topbar-right{
    display:flex;
    align-items:center;
    gap:20px;
}

.topbar a:hover{
    color:#fff;
}


/* =========================================================
   NAVBAR
   ========================================================= */

.navbar{
    position:sticky;
    top:0;
    z-index:1000;

    background:rgba(255,255,255,.97);

    backdrop-filter:blur(15px);

    border-bottom:1px solid var(--border);
}

.nav-inner{
    min-height:78px;

    display:flex;

    align-items:center;
    justify-content:space-between;

    gap:25px;
}

.logo{
    display:flex;
    align-items:center;

    gap:11px;

    color:var(--dark);

    font-size:21px;

    font-weight:900;
}

.logo-mark{
    width:42px;
    height:42px;

    border-radius:11px;

    background:var(--primary);

    color:#fff;

    display:grid;
    place-items:center;

    font-size:19px;
    font-weight:900;
}

.logo small{
    display:block;

    color:var(--secondary-dark);

    font-size:8px;

    letter-spacing:2px;

    margin-top:-3px;
}

.nav-links{
    display:flex;

    align-items:center;

    gap:24px;
}

.nav-links a{
    color:#475569;

    font-size:13px;

    font-weight:700;
}

.nav-links a:hover{
    color:var(--primary);
}

.nav-actions{
    display:flex;

    align-items:center;

    gap:10px;
}

.menu-btn{
    display:none;

    width:43px;
    height:43px;

    border:1px solid var(--border);

    background:#fff;

    border-radius:10px;

    cursor:pointer;

    font-size:21px;
}


/* =========================================================
   HERO
   ========================================================= */

.hero{
    position:relative;

    overflow:hidden;

    min-height:650px;

    background:

        linear-gradient(
            90deg,
            rgba(15,23,42,.94) 0%,
            rgba(30,58,138,.82) 50%,
            rgba(30,58,138,.35) 100%
        ),

        url("https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=2000&q=85")
        center/cover;
}

.hero-inner{
    min-height:650px;

    display:grid;

    grid-template-columns:
        1.15fr
        .85fr;

    align-items:center;

    gap:55px;
}

.hero-content{
    max-width:700px;
}

.hero-label{
    display:inline-flex;

    align-items:center;

    gap:9px;

    color:#fde68a;

    font-size:12px;

    font-weight:900;

    letter-spacing:2px;

    margin-bottom:20px;
}

.hero-label span{
    width:30px;
    height:2px;

    background:var(--secondary);
}

.hero h1{
    color:#fff;

    font-size:
        clamp(42px,6vw,70px);

    line-height:1.03;

    letter-spacing:-3px;

    margin-bottom:22px;

    font-weight:900;
}

.hero h1 strong{
    color:#fcd34d;
}

.hero p{
    color:#dbeafe;

    font-size:16px;

    max-width:640px;

    margin-bottom:30px;
}

.hero-buttons{
    display:flex;

    flex-wrap:wrap;

    gap:12px;
}


/* HERO CARD */

.hero-card{
    width:min(390px,100%);

    justify-self:end;

    background:
        rgba(255,255,255,.12);

    backdrop-filter:blur(17px);

    border:
        1px solid
        rgba(255,255,255,.25);

    border-radius:22px;

    padding:30px;

    color:#fff;
}

.hero-card-top{
    display:flex;

    align-items:center;

    gap:15px;

    margin-bottom:22px;
}

.school-symbol{
    width:64px;
    height:64px;

    border-radius:16px;

    background:var(--secondary);

    color:#111827;

    display:grid;
    place-items:center;

    font-size:27px;
    font-weight:900;
}

.hero-card small{
    color:#fde68a;

    font-size:10px;

    font-weight:900;

    letter-spacing:1.5px;
}

.hero-card h3{
    font-size:21px;

    margin-top:4px;
}

.hero-card p{
    color:#dbeafe;

    font-size:11px;

    margin:0;
}

.hero-card-info{
    display:grid;

    grid-template-columns:
        1fr
        1fr;

    gap:10px;
}

.hero-mini{
    background:
        rgba(255,255,255,.09);

    border-radius:12px;

    padding:14px;
}

.hero-mini strong{
    display:block;

    font-size:22px;
}

.hero-mini span{
    color:#cbd5e1;

    font-size:10px;
}


/* =========================================================
   QUICK INFO
   ========================================================= */

.quick-info{
    margin-top:-45px;

    position:relative;

    z-index:5;
}

.quick-grid{
    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    background:#fff;

    border-radius:20px;

    overflow:hidden;

    box-shadow:var(--shadow-lg);
}

.quick-item{
    padding:27px 20px;

    text-align:center;

    border-right:
        1px solid
        var(--border);
}

.quick-item:last-child{
    border-right:0;
}

.quick-icon{
    width:43px;
    height:43px;

    border-radius:12px;

    background:#dbeafe;

    color:var(--primary);

    display:grid;
    place-items:center;

    margin:0 auto 10px;

    font-size:19px;
}

.quick-item strong{
    display:block;

    color:var(--dark);

    font-size:14px;

    margin-bottom:3px;
}

.quick-item span{
    color:var(--muted);

    font-size:11px;
}


/* =========================================================
   ABOUT
   ========================================================= */

.about-grid{
    display:grid;

    grid-template-columns:
        .9fr
        1.1fr;

    gap:70px;

    align-items:center;
}

.about-visual{
    position:relative;
}

.about-image{
    min-height:510px;

    border-radius:25px;

    background:

        linear-gradient(
            0deg,
            rgba(15,23,42,.05),
            rgba(15,23,42,.05)
        ),

        url("https://images.unsplash.com/photo-1580582932707-520aed937b7b?auto=format&fit=crop&w=1100&q=85")
        center/cover;
}

.about-badge{
    position:absolute;

    right:-22px;

    bottom:28px;

    width:195px;

    padding:23px;

    border-radius:18px;

    background:var(--secondary);

    color:#111827;

    box-shadow:var(--shadow-lg);
}

.about-badge strong{
    display:block;

    font-size:30px;

    line-height:1;

    margin-bottom:5px;
}

.about-badge span{
    font-size:11px;

    font-weight:700;
}

.about-content .section-title{
    text-align:left;
}

.about-content p{
    color:var(--muted);

    margin-bottom:16px;

    font-size:14px;
}

.about-list{
    list-style:none;

    display:grid;

    gap:11px;

    margin:24px 0 28px;
}

.about-list li{
    display:flex;

    gap:11px;

    align-items:center;

    font-size:13px;

    font-weight:750;
}

.check{
    width:22px;
    height:22px;

    flex:0 0 22px;

    border-radius:50%;

    background:#dbeafe;

    color:var(--primary);

    display:grid;

    place-items:center;

    font-size:11px;

    font-weight:900;
}


/* =========================================================
   ACADEMICS
   ========================================================= */

.academics{
    background:var(--light-blue);
}

.academic-grid{
    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:18px;
}

.academic-card{
    background:#fff;

    border:
        1px solid
        var(--border);

    border-radius:17px;

    padding:28px;

    transition:.25s;
}

.academic-card:hover{
    transform:translateY(-5px);

    box-shadow:var(--shadow);
}

.academic-icon{
    width:49px;
    height:49px;

    border-radius:13px;

    background:#dbeafe;

    color:var(--primary);

    display:grid;

    place-items:center;

    font-size:22px;

    margin-bottom:18px;
}

.academic-card h3{
    color:var(--dark);

    font-size:18px;

    margin-bottom:8px;
}

.academic-card p{
    color:var(--muted);

    font-size:13px;
}


/* =========================================================
   PROGRAMS
   ========================================================= */

.program-grid{
    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:20px;
}

.program-card{
    padding:29px;

    border:
        1px solid
        var(--border);

    border-radius:18px;

    background:#fff;

    transition:.25s;
}

.program-card:hover{
    box-shadow:var(--shadow);

    transform:translateY(-4px);
}

.program-number{
    color:var(--secondary-dark);

    font-size:11px;

    font-weight:900;

    letter-spacing:1px;

    margin-bottom:20px;
}

.program-card h3{
    color:var(--dark);

    font-size:19px;

    margin-bottom:8px;
}

.program-card p{
    color:var(--muted);

    font-size:13px;

    margin-bottom:18px;
}

.program-card a{
    color:var(--primary);

    font-size:12px;

    font-weight:850;
}


/* =========================================================
   FEATURES
   ========================================================= */

.features{
    background:var(--dark);

    color:#fff;
}

.features-grid{
    display:grid;

    grid-template-columns:
        1fr
        1fr;

    gap:65px;

    align-items:center;
}

.features .section-title{
    color:#fff;

    text-align:left;
}

.features-description{
    color:#94a3b8;

    margin-bottom:28px;

    font-size:14px;
}

.feature-list{
    display:grid;

    gap:14px;
}

.feature-item{
    display:flex;

    gap:14px;

    padding:16px;

    border:
        1px solid
        rgba(255,255,255,.08);

    background:
        rgba(255,255,255,.04);

    border-radius:13px;
}

.feature-icon{
    width:42px;
    height:42px;

    flex:0 0 42px;

    display:grid;

    place-items:center;

    border-radius:10px;

    background:
        rgba(245,158,11,.14);

    color:#fcd34d;
}

.feature-item h4{
    font-size:14px;

    margin-bottom:2px;
}

.feature-item p{
    color:#94a3b8;

    font-size:11px;
}

.features-image{
    min-height:500px;

    border-radius:24px;

    background:

        linear-gradient(
            rgba(15,23,42,.12),
            rgba(15,23,42,.25)
        ),

        url("https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=1200&q=85")
        center/cover;
}


/* =========================================================
   CAMPUS FACILITIES
   ========================================================= */

.facility-grid{
    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:18px;
}

.facility{
    text-align:center;

    padding:25px 18px;

    border:
        1px solid
        var(--border);

    border-radius:16px;
}

.facility-icon{
    font-size:28px;

    color:var(--primary);

    margin-bottom:10px;
}

.facility h3{
    color:var(--dark);

    font-size:15px;

    margin-bottom:4px;
}

.facility p{
    color:var(--muted);

    font-size:11px;
}


/* =========================================================
   FACULTY
   ========================================================= */

.faculty{
    background:var(--light);
}

.faculty-grid{
    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:21px;
}

.faculty-card{
    border:
        1px solid
        var(--border);

    border-radius:18px;

    overflow:hidden;

    background:#fff;
}

.faculty-photo{
    height:300px;

    background-position:center;

    background-size:cover;
}

.faculty-card:nth-child(1)
.faculty-photo{
    background-image:
        url("https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=800&q=85");
}

.faculty-card:nth-child(2)
.faculty-photo{
    background-image:
        url("https://images.unsplash.com/photo-1544005313-94ddf0286df2?auto=format&fit=crop&w=800&q=85");
}

.faculty-card:nth-child(3)
.faculty-photo{
    background-image:
        url("https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=800&q=85");
}

.faculty-info{
    padding:20px;
}

.faculty-info h3{
    color:var(--dark);

    font-size:18px;
}

.faculty-info span{
    color:var(--primary);

    font-size:11px;

    font-weight:850;
}


/* =========================================================
   CAMPUS GALLERY
   ========================================================= */

.gallery-grid{
    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:14px;
}

.gallery-item{
    height:215px;

    border-radius:14px;

    background-position:center;

    background-size:cover;
}

.gallery-item:nth-child(1){
    background-image:
        url("https://images.unsplash.com/photo-1564981797816-1043664bf78d?auto=format&fit=crop&w=700&q=85");
}

.gallery-item:nth-child(2){
    background-image:
        url("https://images.unsplash.com/photo-1577896851231-70ef18881754?auto=format&fit=crop&w=700&q=85");
}

.gallery-item:nth-child(3){
    background-image:
        url("https://images.unsplash.com/photo-1524178232363-1fb2b075b655?auto=format&fit=crop&w=700&q=85");
}

.gallery-item:nth-child(4){
    background-image:
        url("https://images.unsplash.com/photo-1503676260728-1c00da094a0b?auto=format&fit=crop&w=700&q=85");
}

.gallery-item:nth-child(5){
    background-image:
        url("https://images.unsplash.com/photo-1497633762265-9d179a990aa6?auto=format&fit=crop&w=700&q=85");
}

.gallery-item:nth-child(6){
    background-image:
        url("https://images.unsplash.com/photo-1509062522246-3755977927d7?auto=format&fit=crop&w=700&q=85");
}

.gallery-item:nth-child(7){
    background-image:
        url("https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=700&q=85");
}

.gallery-item:nth-child(8){
    background-image:
        url("https://images.unsplash.com/photo-1523240795612-9a054b0db644?auto=format&fit=crop&w=700&q=85");
}


/* =========================================================
   ACHIEVEMENTS
   ========================================================= */

.achievements{
    background:var(--light-blue);
}

.achievement-grid{
    display:grid;

    grid-template-columns:
        repeat(4,1fr);

    gap:15px;
}

.achievement{
    text-align:center;

    padding:28px 18px;

    background:#fff;

    border:
        1px solid
        var(--border);

    border-radius:16px;
}

.achievement strong{
    display:block;

    color:var(--primary);

    font-size:34px;

    line-height:1;

    margin-bottom:7px;
}

.achievement span{
    color:var(--muted);

    font-size:11px;

    font-weight:700;
}


/* =========================================================
   TESTIMONIALS
   ========================================================= */

.testimonial-grid{
    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:20px;
}

.testimonial{
    padding:29px;

    border:
        1px solid
        var(--border);

    border-radius:18px;

    background:#fff;
}

.quote{
    color:var(--secondary);

    font-size:35px;

    line-height:1;

    margin-bottom:17px;
}

.testimonial p{
    color:#475569;

    font-size:13px;

    margin-bottom:23px;
}

.testimonial-person{
    display:flex;

    align-items:center;

    gap:11px;
}

.person-avatar{
    width:42px;
    height:42px;

    border-radius:50%;

    background:#dbeafe;

    color:var(--primary);

    display:grid;

    place-items:center;

    font-size:12px;

    font-weight:900;
}

.person-info strong{
    display:block;

    color:var(--dark);

    font-size:12px;
}

.person-info span{
    color:var(--muted);

    font-size:10px;
}


/* =========================================================
   FAQ
   ========================================================= */

.faq{
    background:var(--light);
}

.faq-wrap{
    max-width:850px;

    margin:auto;
}

.faq-item{
    background:#fff;

    border:
        1px solid
        var(--border);

    border-radius:13px;

    overflow:hidden;

    margin-bottom:11px;
}

.faq-question{
    width:100%;

    border:0;

    background:#fff;

    color:var(--dark);

    padding:20px 21px;

    display:flex;

    align-items:center;

    justify-content:space-between;

    cursor:pointer;

    text-align:left;

    font-weight:800;

    font-size:13px;
}

.faq-icon{
    width:28px;
    height:28px;

    border-radius:50%;

    display:grid;

    place-items:center;

    background:#f1f5f9;

    color:var(--primary);

    transition:.25s;
}

.faq-answer{
    max-height:0;

    overflow:hidden;

    transition:.3s ease;
}

.faq-answer-inner{
    padding:0 21px 20px;

    color:var(--muted);

    font-size:12px;
}

.faq-item.active
.faq-answer{
    max-height:180px;
}

.faq-item.active
.faq-icon{
    transform:rotate(45deg);

    background:#dbeafe;
}


/* =========================================================
   ADMISSION CTA
   ======================
